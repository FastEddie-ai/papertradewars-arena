# Copy to .env (never commit real secrets)
ADMIN_SECRET=change-this-to-something-long-and-random
SITE_TITLE=PaperTradeWars
PORT=3000

# Primary database (Turso). If unset, the app uses a local SQLite file —
# dev-only: fine locally, but it resets on Render's free tier.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local-dev alternative to TURSO_DATABASE_URL (a file: URL or a plain path)
# DB_PATH=./data/arena.db

# Public base URL of the deployed app. Set to the https Render URL in
# production — it switches session cookies to Secure.
APP_URL=http://localhost:3000

# Price-feed overrides (QA/stubbing only; defaults are Yahoo Finance + CoinGecko)
# YAHOO_URL_TEMPLATE=https://query1.finance.yahoo.com/v8/finance/chart/{T}?interval=1d&range=1d
# COINGECKO_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,ripple,dogecoin&vs_currencies=usd
